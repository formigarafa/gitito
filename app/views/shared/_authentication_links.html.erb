<p class="auth__links">
  <% case controller_name %>
  <% when "sessions" %>
    <span>New to gitito? <%= link_to "Create an account", new_registration_path %></span>
  <% when "registrations" %>
    <span>Already have an account? <%= link_to "Sign in", new_session_path %></span>
  <% else %>
    <%= link_to "Back to sign in", new_session_path %>
    <%= link_to "Create an account", new_registration_path %>
  <% end %>
</p>
