<header class="page-header">
  <div class="page-header__text">
    <% if back %>
      <%= link_to back.last, class: "back-link" do %>
        <%= icon "arrow-left" %> <%= back.first %>
      <% end %>
    <% end %>
    <h1><%= title %></h1>
    <% if subtitle %>
      <p class="page-header__subtitle"><%= subtitle %></p>
    <% end %>
  </div>
  <% if actions %>
    <div class="page-header__actions"><%= actions %></div>
  <% end %>
</header>
