<button type="button" class="copy-button" data-action="clipboard#copy" aria-label="<%= label %>" title="<%= label %>">
  <span class="copy-button__idle"><%= icon "copy" %> <span class="copy-button__label">Copy</span></span>
  <span class="copy-button__done"><%= icon "check" %> <span class="copy-button__label">Copied</span></span>
</button>
<span class="sr-only" role="status" data-clipboard-target="status"></span>
