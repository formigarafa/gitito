<% if flash.any? %>
  <div class="flash">
    <% flash.each do |type, message| %>
      <div class="message <%= type %>" role="<%= type == "notice" ? "status" : "alert" %>" data-controller="dismiss">
        <%= icon(type == "notice" ? "circle-check" : "circle-alert") %>
        <p><%= message %></p>
        <button type="button" class="message__dismiss" data-action="dismiss#remove" aria-label="Dismiss">
          <%= icon "x" %>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
