<div class="block" id="block-signup">
  <h2>Sign up</h2>
  <div class="content">
    <%= render "shared/error_messages", resource: @user %>

    <%= form_with model: @user, url: registration_path, class: "form login" do |f| %>
      <div class="group wat-cf">
        <div class="left">
          <%= f.label :username, "username", class: "label" %>
        </div>
        <div class="right">
          <%= f.text_field :username, required: true, autofocus: true %>
        </div>
      </div>

      <div class="group wat-cf">
        <div class="left">
          <%= f.label :email, "email", class: "label" %>
        </div>
        <div class="right">
          <%= f.email_field :email, required: true, autocomplete: "username" %>
        </div>
      </div>

      <div class="group wat-cf">
        <div class="left">
          <%= f.label :password, "password", class: "label" %>
        </div>
        <div class="right">
          <%= f.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>
      </div>

      <div class="group navform wat-cf">
        <div class="right">
          <button class="button" type="submit">
            <%= image_tag "web-app-theme/icons/tick.png", alt: "Save" %> Signup
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/authentication_links" %>
