<% content_for :title, "Create your account" %>

<section class="card">
  <div class="card__body">
    <h1>Create your account</h1>

    <%= render "shared/error_messages", resource: @user %>

    <%= form_with model: @user, url: registration_path, class: "form" do |f| %>
      <div class="field">
        <%= f.label :username, "Username" %>
        <%= f.text_field :username, class: "input", required: true, autofocus: true, autocomplete: "off",
              autocapitalize: "none", spellcheck: false, pattern: "[A-Za-z0-9][A-Za-z0-9._\\-]*",
              title: "Letters, digits, dashes, underscores and dots, starting with a letter or a digit" %>
        <p class="field__hint">
          It names your repositories, as in
          <code><%= clone_url_example %></code>, and can't be changed later.
        </p>
      </div>

      <div class="field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, class: "input", required: true, autocomplete: "username" %>
      </div>

      <div class="field">
        <%= f.label :password, "Password" %>
        <%= password_field_with_toggle f, :password, required: true, autocomplete: "new-password", minlength: 6, maxlength: 72 %>
        <p class="field__hint">At least 6 characters.</p>
      </div>

      <button class="btn btn--primary btn--block" type="submit">Create account</button>
    <% end %>
  </div>
</section>

<%= render "shared/authentication_links" %>
