<% if authenticated? %>
  <li>
    <%= link_to Current.user.username, edit_registration_path %>
  </li>
  <li>
    <%= button_to "Logout", session_path, method: :delete, class: "logout link_button", form: { class: "button_to inline" } %>
  </li>
<% else %>
  <li>
    <%= link_to "Register", new_registration_path %>
  </li>
  <li>
    <%= link_to "Login", new_session_path %>
  </li>
<% end %>
