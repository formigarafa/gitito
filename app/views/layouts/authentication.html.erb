<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body class="auth">
    <main class="auth__main" id="main">
      <%= link_to root_path, class: "auth__brand" do %>
        <%= render "shared/logo" %>
        gitito
        <span class="auth__tagline">Private git repositories over SSH</span>
      <% end %>

      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
