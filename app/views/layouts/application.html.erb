<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body class="app">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="topbar__inner">
        <%= link_to root_path, class: "brand" do %>
          <%= render "shared/logo" %> gitito
        <% end %>

        <nav class="topnav" aria-label="Main">
          <%= nav_link "Repositories", repositories_path, icon: "folder-git-2", active: %w[repositories collaborators] %>
          <%= nav_link "SSH keys", user_credentials_path, icon: "key-round", active: %w[user_credentials] %>
        </nav>

        <div class="usernav">
          <%= render "layouts/user_navigation" %>
        </div>
      </div>
    </header>

    <main class="page" id="main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="footer">
      gitito · private git repositories over SSH
    </footer>

    <%= render "shared/confirm_dialog" %>
  </body>
</html>
