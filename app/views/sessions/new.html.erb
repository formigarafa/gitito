<% content_for :title, "Sign in" %>

<section class="card">
  <div class="card__body">
    <h1>Sign in</h1>

    <%= form_with url: session_path, class: "form" do |f| %>
      <div class="field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, class: "input", required: true, autofocus: true, autocomplete: "username", value: params[:email] %>
      </div>

      <div class="field">
        <div class="field__label-row">
          <%= f.label :password, "Password" %>
          <%= link_to "Forgot your password?", new_password_path %>
        </div>
        <%= password_field_with_toggle f, :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      </div>

      <div class="checkbox">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "Keep me signed in on this device" %>
      </div>

      <button class="btn btn--primary btn--block" type="submit">Sign in</button>
    <% end %>
  </div>
</section>

<%= render "shared/authentication_links" %>
