<div class="block" id="block-login">
  <h2>Login Box</h2>
  <div class="content login">
    <%= form_with url: session_path, class: "form login" do |f| %>
      <div class="group wat-cf">
        <div class="left">
          <%= f.label :email, "email", class: "label right" %>
        </div>
        <div class="right">
          <%= f.email_field :email, class: :text_field, required: true, autofocus: true, autocomplete: "username", value: params[:email] %>
        </div>
      </div>

      <div class="group wat-cf">
        <div class="left">
          <%= f.label :password, "password", class: "label right" %>
        </div>
        <div class="right">
          <%= f.password_field :password, class: :text_field, required: true, autocomplete: "current-password", maxlength: 72 %>
        </div>
      </div>

      <div class="group wat-cf">
        <div class="right">
          <%= f.check_box :remember_me %> <%= f.label :remember_me %>
        </div>
      </div>

      <div class="group navform wat-cf">
        <div class="right">
          <button class="button" type="submit">
            <%= image_tag "web-app-theme/icons/key.png", alt: "Save" %> Login
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/authentication_links" %>
