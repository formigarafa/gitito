<%= render "shared/error_messages", resource: @user_credential %>

<div class="field">
  <%= f.label :title, "Title" %>
  <%= f.text_field :title, class: "input", autofocus: true, autocomplete: "off", placeholder: "Work laptop",
        aria: { describedby: "user_credential_title_hint" } %>
  <p class="field__hint" id="user_credential_title_hint">A name to recognise the key by, like the computer it is on.</p>
</div>

<div class="field">
  <%= f.label :key, "Key" %>
  <%= f.text_area :key, class: "input input--mono", required: true, rows: 5, autocomplete: "off", autocapitalize: "none",
        spellcheck: false, placeholder: "ssh-ed25519 AAAAC3… you@computer", aria: { describedby: "user_credential_key_hint" } %>
  <p class="field__hint" id="user_credential_key_hint">
    The one line of a public key. It starts with <code>ssh-ed25519</code>, <code>ssh-rsa</code> or <code>ecdsa-sha2-…</code>
  </p>
</div>

<div class="form__actions">
  <button class="btn btn--primary" type="submit"><%= submit %></button>
  <%= link_to "Cancel", user_credentials_path, class: "btn btn--ghost" %>
</div>
