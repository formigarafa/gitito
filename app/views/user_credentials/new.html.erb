<%= page_header "Add an SSH key", back: [ "All SSH keys", user_credentials_path ] %>

<section class="card">
  <div class="card__body">
    <%= form_with model: @user_credential, class: "form" do |f| %>
      <%= render "form", f: f, submit: "Add key" %>
    <% end %>
  </div>
</section>

<section class="card">
  <div class="card__header">
    <h2>Where is my public key?</h2>
  </div>
  <div class="card__body steps">
    <div>
      <h3>Print the one you have, and paste it above</h3>
      <%= snippet "cat ~/.ssh/id_ed25519.pub", label: "Copy the command" %>
    </div>
    <div>
      <h3>No such file? Create a key first</h3>
      <%= snippet %(ssh-keygen -t ed25519 -C "#{Current.user&.email}"), label: "Copy the command" %>
    </div>
    <p class="muted">Only the public key, the file ending in <code>.pub</code>, goes here. The other one never leaves your computer.</p>
  </div>
</section>
