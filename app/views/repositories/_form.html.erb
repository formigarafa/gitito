<%= render "shared/error_messages", resource: @repository %>

<div class="field">
  <%= f.label :name, "Name" %>
  <div class="input-group">
    <% if Current.user %>
      <span class="input-group__prefix"><%= Current.user.username %>/</span>
    <% end %>
    <%= f.text_field :name, class: "input input--mono", required: true, autofocus: true, autocomplete: "off",
          autocapitalize: "none", spellcheck: false, placeholder: "project", pattern: "[A-Za-z0-9._\\-]+",
          title: "Letters, digits, dashes, underscores and dots", aria: { describedby: "repository_name_hint" } %>
  </div>
  <p class="field__hint" id="repository_name_hint">
    Letters, digits, dashes, underscores and dots. It is part of the clone URL and can't be changed later.
  </p>
</div>

<div class="form__actions">
  <button class="btn btn--primary" type="submit">Create repository</button>
  <%= link_to "Cancel", repositories_path, class: "btn btn--ghost" %>
</div>
