<%= page_header "Repositories", subtitle: "The git repositories you own, and the ones shared with you." do %>
  <%= link_to new_repository_path, class: "btn btn--primary" do %>
    <%= icon "plus" %> New repository
  <% end %>
<% end %>

<%= render "shared/ssh_key_missing" %>

<section>
  <h2 class="section-title">
    Your repositories
    <span class="badge badge--neutral"><%= @repositories.size %></span>
  </h2>

  <div class="card">
    <% if @repositories.any? %>
      <ul class="list">
        <% @repositories.each do |repository| %>
          <li>
            <div class="list__main">
              <div class="list__title"><%= link_to repository.name, repository %></div>
              <div class="list__meta">
                <% if repository.collaborators.any? %>
                  <span><%= pluralize repository.collaborators.size, "collaborator" %></span>
                <% else %>
                  <span>Only you</span>
                <% end %>
              </div>
            </div>
            <%= copy_field repository.url, label: "Copy the clone URL of #{repository.name}", compact: true %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="empty">
        <span class="list__icon"><%= icon "folder-git-2" %></span>
        <h3>No repositories yet</h3>
        <p>Create one and push to it over SSH. You can then share it with other people on this server.</p>
        <%= link_to new_repository_path, class: "btn btn--primary" do %>
          <%= icon "plus" %> Create a repository
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<% if @collaborative_repositories.any? %>
  <section>
    <h2 class="section-title">
      Shared with you
      <span class="badge badge--neutral"><%= @collaborative_repositories.size %></span>
    </h2>

    <div class="card">
      <ul class="list">
        <% @collaborative_repositories.each do |repository| %>
          <li>
            <div class="list__main">
              <div class="list__title"><%= repository.name %></div>
              <div class="list__meta">
                <span>Owned by <%= repository.user.username %> · you can fetch and push</span>
              </div>
            </div>
            <%= copy_field repository.url, label: "Copy the clone URL of #{repository.name}", compact: true %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
<% end %>
