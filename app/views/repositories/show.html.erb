<%= page_header @repository.name, back: [ "All repositories", repositories_path ] %>

<%= render "shared/ssh_key_missing" %>

<section class="card">
  <div class="card__header">
    <h2>Clone URL</h2>
  </div>
  <div class="card__body">
    <%= copy_field @repository.url, label: "Copy the clone URL", class: "copy-field--lg" %>

    <div class="steps">
      <div>
        <h3>Clone it to your computer</h3>
        <%= snippet "git clone #{@repository.url}", label: "Copy the command" %>
      </div>
      <div>
        <h3>Or push a repository you already have</h3>
        <%= snippet "git remote add origin #{@repository.url}\ngit push -u origin main", label: "Copy the commands" %>
      </div>
    </div>
  </div>
</section>

<section class="card collaborators">
  <div class="card__header">
    <h2>
      Collaborators
      <span class="badge badge--neutral"><%= @repository.collaborators.size %></span>
    </h2>
    <p>They can fetch from and push to this repository. Only you can delete it or choose who collaborates.</p>
  </div>

  <% if @repository.collaborators.any? %>
    <ul class="list">
      <% @repository.collaborators.includes(:user).each do |collaborator| %>
        <li class="collaborator">
          <%= avatar collaborator.user %>
          <div class="list__main">
            <div class="list__title collaborator__name"><%= collaborator.username %></div>
          </div>
          <%= delete_button "Remove", repository_collaborator_path(@repository, collaborator),
                title: "Remove #{collaborator.username}?",
                confirm: "#{collaborator.username} will no longer be able to fetch from or push to #{@repository.name}." %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card__body">
      <p class="muted">Nobody else has access to this repository.</p>
    </div>
  <% end %>

  <div class="card__footer">
    <%= form_with model: [ @repository, Collaborator.new ], class: "inline-form" do |f| %>
      <div class="field">
        <%= f.label :username, "Add a collaborator" %>
        <%= f.text_field :username, class: "input", required: true, autocomplete: "off", autocapitalize: "none",
              spellcheck: false, placeholder: "Their username on this server" %>
      </div>
      <button class="btn btn--primary" type="submit"><%= icon "plus" %> Add</button>
    <% end %>
  </div>
</section>

<section class="card card--danger">
  <div class="card__header">
    <h2>Danger zone</h2>
  </div>
  <div class="card__body">
    <div class="action-row">
      <div class="action-row__text">
        <h3>Delete this repository</h3>
        <p>Everything pushed to it is removed from the server, for you and your collaborators. There is no way back.</p>
      </div>
      <%= delete_button safe_join([ icon("trash-2"), "Delete repository" ], " "), repository_path(@repository),
            class: "btn btn--danger-quiet", title: "Delete #{@repository.name}?",
            confirm: "Everything pushed to #{@repository.url} will be removed from the server. This can't be undone." %>
    </div>
  </div>
</section>
