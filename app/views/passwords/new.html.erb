<% content_for :title, "Reset your password" %>

<section class="card">
  <div class="card__body">
    <h1>Reset your password</h1>
    <p class="muted">Tell us the email of your account and we'll send you a link to choose a new password.</p>

    <%= form_with url: passwords_path, class: "form" do |f| %>
      <div class="field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, class: "input", required: true, autofocus: true, autocomplete: "username", value: params[:email] %>
      </div>

      <button class="btn btn--primary btn--block" type="submit">Email me a reset link</button>
    <% end %>
  </div>
</section>

<%= render "shared/authentication_links" %>
