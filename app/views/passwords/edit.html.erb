<div class="block" id="block-login">
  <h2>Change your password</h2>
  <div class="content login">
    <%= render "shared/error_messages", resource: @user %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "form login" do |f| %>
      <div class="group wat-cf">
        <div class="left">
          <%= f.label :password, "new password", class: "label right" %>
        </div>
        <div class="right">
          <%= f.password_field :password, class: :text_field, required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>
      </div>

      <div class="group wat-cf">
        <div class="left">
          <%= f.label :password_confirmation, "confirm new password", class: "label right" %>
        </div>
        <div class="right">
          <%= f.password_field :password_confirmation, class: :text_field, required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>
      </div>

      <div class="group navform wat-cf">
        <div class="right">
          <button class="button" type="submit">
            <%= image_tag "web-app-theme/icons/key.png", alt: "Save" %> Change my password
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/authentication_links" %>
