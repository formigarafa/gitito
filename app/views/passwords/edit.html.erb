<% content_for :title, "Choose a new password" %>

<section class="card">
  <div class="card__body">
    <h1>Choose a new password</h1>

    <%= render "shared/error_messages", resource: @user %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |f| %>
      <div class="field">
        <%= f.label :password, "New password" %>
        <%= password_field_with_toggle f, :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 6, maxlength: 72 %>
        <p class="field__hint">At least 6 characters.</p>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Repeat the new password" %>
        <%= password_field_with_toggle f, :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>

      <button class="btn btn--primary btn--block" type="submit">Change my password</button>
    <% end %>
  </div>
</section>

<%= render "shared/authentication_links" %>
